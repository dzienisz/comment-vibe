{
  "manifest_version": 3,
  "name": "Comment Vibe",
  "short_name": "Comment Vibe",
  "description": "Check comment tone with Chrome's on-device AI. Get kinder rewrite suggestions before you post. Private — no data sent anywhere.",
  "version": "1.1.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comment Vibe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
