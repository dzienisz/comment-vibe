{
  "manifest_version": 3,
  "name": "Comment Vibe",
  "short_name": "Comment Vibe",
  "description": "Write with more clarity. Private, on-device AI shows how your comment may land and suggests a kinder rewrite before you post.",
  "version": "1.3.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comment Vibe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
