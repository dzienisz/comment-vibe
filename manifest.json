{
  "manifest_version": 3,
  "name": "Comment Vibe — Private AI Tone Checker & Comment Rewriter",
  "short_name": "Comment Vibe",
  "description": "On-device AI checks your comment's tone on LinkedIn, X, YouTube or Reddit and offers a kinder rewrite before posting. Private, free.",
  "version": "1.12.1",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["https://api.subq.ai/*", "https://api.typesafe.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comment Vibe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "jev.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
