# Store publishing secrets, shared by all of the publisher's extensions.
# Same names in comment-vibe and chrome-ssr-csr. Keep the filled-in copy in a
# password manager, never in a repo (store-secrets.env is gitignored).
#
# New extension repo:
#   cp store-secrets.env.example store-secrets.env   # fill in, or paste from the password manager
#   gh secret set -f store-secrets.env -R dzienisz/<repo>
#   gh secret set CWS_EXTENSION_ID -R dzienisz/<repo>  # per extension
#   gh secret set EDGE_PRODUCT_ID -R dzienisz/<repo>   # per extension
#   rm store-secrets.env
#
# Chrome Web Store API (Google Cloud OAuth client, "Desktop app"):
# https://github.com/fregante/chrome-webstore-upload-keys
# Set the OAuth consent screen to "In production": while it is "Testing",
# Google expires the refresh token after 7 days.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
# chrome-ssr-csr only (publisher-scoped API); same value for every extension.
CWS_PUBLISHER_ID=

# addons.mozilla.org: https://addons.mozilla.org/developers/addon/api/key/
# The add-on is identified by the gecko id in its manifest.
AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# Microsoft Edge Add-ons: Partner Center → Microsoft Edge → Publish API.
EDGE_CLIENT_ID=
EDGE_API_KEY=
