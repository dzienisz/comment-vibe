{
  "manifest_version": 3,
  "name": "Firefox AI Playground (Comment Vibe)",
  "short_name": "Firefox AI Playground",
  "description": "Try every task of Firefox's on-device WebExtensions AI API (browser.trial.ml) in one page. Developer playground from the Comment Vibe project.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-ai-playground@dzienko.dev",
      "strict_min_version": "134.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_title": "Firefox AI Playground", "default_icon": { "48": "icon48.png" } },
  "permissions": ["storage"],
  "optional_permissions": ["trialML"],
  "background": { "scripts": ["background.js"] }
}
