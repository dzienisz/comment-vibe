{
  "manifest_version": 3,
  "name": "Comment Vibe — Private AI Tone Checker & Comment Rewriter",
  "short_name": "Comment Vibe",
  "description": "On-device AI checks the tone of your comment on LinkedIn, X, YouTube or Reddit and offers a kinder rewrite before you post. Private, free.",
  "version": "1.11.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "comment-vibe@dzienko.dev",
      "strict_min_version": "134.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comment Vibe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "optional_permissions": ["trialML"],
  "optional_host_permissions": ["https://api.subq.ai/*", "https://api.typesafe.ai/*"],
  "background": {
    "scripts": ["jev.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
